{
  "name": "memberstack-api",
  "version": "0.0.1",
  "description": "membership managment backend",
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "20 || 22 || 24"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "start": "node .",
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "npm run eslint && npm run prettier:check",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "npm run prettier:cli -- -l",
    "prettier:fix": "npm run prettier:cli -- --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "npm run eslint -- --fix",
    "pretest": "npm run rebuild",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "posttest": "npm run lint",
    "test:dev": "lb-mocha --allow-console-logs dist/__tests__/**/*.js && npm run posttest",
    "docker:build": "docker build -t memberstack-api .",
    "docker:run": "docker run -p 3000:3000 -d memberstack-api",
    "premigrate": "npm run build",
    "preopenapi-spec": "npm run build",
    "openapi-spec": "node ./dist/openapi-spec",
    "prestart": "npm run rebuild",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "npm run clean && npm run build",
    "migrate": "ts-node src/migrate.ts"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "TosoK <tosekleckaroski@gmail.com>",
  "license": "",
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/authentication": "^12.0.16",
    "@loopback/authentication-jwt": "^0.16.16",
    "@loopback/authorization": "^0.16.15",
    "@loopback/boot": "^8.0.12",
    "@loopback/core": "^7.0.11",
    "@loopback/logging": "^0.13.15",
    "@loopback/repository": "^8.0.11",
    "@loopback/rest": "^15.0.12",
    "@loopback/rest-explorer": "^8.0.12",
    "@loopback/security": "^0.12.15",
    "@loopback/service-proxy": "^8.0.11",
    "bcrypt": "^6.0.0",
    "casbin": "^5.51.1",
    "casbin-basic-adapter": "^1.3.0",
    "chalk": "4.1.2",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "loopback-connector-postgresql": "^8.0.8",
    "pg": "^8.20.0",
    "tslib": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@loopback/build": "^12.0.11",
    "@loopback/eslint-config": "^16.0.1",
    "@loopback/testlab": "^8.0.11",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "eslint": "^8.57.1",
    "source-map-support": "^0.5.21",
    "typescript": "~5.2.2"
  }
}
