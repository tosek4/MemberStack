#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/@loopback+build@12.0.11/node_modules/@loopback/build/node_modules:/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/@loopback+build@12.0.11/node_modules:/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/@loopback+build@12.0.11/node_modules/@loopback/build/node_modules:/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/@loopback+build@12.0.11/node_modules:/home/toshok/education/MyApp/MemberStack/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@loopback/build/bin/compile-package.js" "$@"
else
  exec node  "$basedir/../@loopback/build/bin/compile-package.js" "$@"
fi
